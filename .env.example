# string: obtain from BotFather; configure as a Railway secret
TELEGRAM_BOT_TOKEN=
# string: 32–256 characters from A-Z a-z 0-9 _ -; configure as a Railway secret
TELEGRAM_WEBHOOK_SECRET=
# absolute HTTPS URL: use the service public domain and this exact path
TELEGRAM_WEBHOOK_URL=https://your-service.up.railway.app/telegram/webhook
# optional positive integer: reserve the owner before startup
# leave blank for first private /stast claimant; ownership is then permanent in SQLite
ADMIN_USER_ID=
# enum: owner | public; keep owner until live acceptance and cost review
BOT_ACCESS_MODE=owner
# enum: disabled | owner | public; independent from private-chat access
GUEST_ACCESS_MODE=disabled
# absolute paths: all persistent paths must remain below /data
OMP_AGENT_DIR=/data/omp/agent
OMP_SESSIONS_DIR=/data/omp/sessions
DATABASE_PATH=/data/app.sqlite
# enum: codex | api; codex subscription OAuth is the default and never falls back to API keys
OMP_AUTH_MODE=codex
# strings: leave BOTH unset for authenticated GPT-6 discovery within the selected auth mode
# set BOTH only to the exact provider/model pair reported by OMP
# OMP_MODEL_PROVIDER=
# OMP_MODEL_ID=
# optional alternative only: set OMP_AUTH_MODE=api to use an API-key provider
# Codex mode uses bot-owned OAuth in OMP_AGENT_DIR/agent.db, not OPENAI_API_KEY
# neither an API key nor a subscription guarantees GPT-6 availability
OPENAI_API_KEY=
# integer: Railway injects PORT; 3000 is for local/container use
PORT=3000
# enum: info | error
LOG_LEVEL=info
# integer: Railway volume permission repair starts as root then drops to bun
RAILWAY_RUN_UID=0
